---
import PortfolioCard from "../components/PortfolioCard";
import { profile, links } from "../data/portfolio.ts";
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <title>{profile.name}</title>

    <meta
      name="description"
      content={profile.bio}
    />
  </head>

  <body>
    <main class="container">
      <section class="profile">
        <div class="avatar">
          EC
        </div>

        <h1>{profile.name}</h1>

        <p class="bio">{profile.bio}</p>
      </section>

      <section class="links" aria-label="Links">
        {
          links.map((link) => (
            <PortfolioCard
              title={link.title}
              description={link.description}
              phase={link.phase}
              url={link.url}
            />
          ))
        }
      </section>

      <footer>
        <span>Ernesto Cisnero &copy; {new Date().getFullYear()}</span>
      </footer>
    </main>
  </body>
</html>