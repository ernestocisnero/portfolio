---
interface App {
  slug: string;
  name: string;
  tagline: string;
  icon?: string;
  color?: string;
  status?: string;
  link?: string;
}

interface Props {
  apps: App[];
}

const { apps } = Astro.props;
---

<section class="apps" id="apps">

  <div class="section-header">
    <div>
      <p class="eyebrow">Selected work</p>
      <h2>Apps I build.</h2>
    </div>

    <p class="section-description">
      Small, focused products designed
      specifically for iPhone and iPad.
    </p>
  </div>


  <div class="app-grid">

    {
      apps.map((app, index) => {

        const Card = app.link ? "a" : "article";

        return (
          <Card
            href={app.link}
            class={`app-card app-card--${index + 1} ${
              !app.link ? "app-card--disabled" : ""
            }`}
          >

            <div class="card-content">

              <div
                class="app-icon"
                style={app.color ? `background:${app.color}` : undefined}
              >
                {app.icon ? (
                  <img src={app.icon} alt="" />
                ) : (
                  <span>R</span>
                )}
              </div>

              <div>
                <h3>{app.name}</h3>
                <p>{app.tagline}</p>
              </div>

            </div>


            <div class="card-footer">

              {
                app.status ? (
                  <span class="status">
                    {app.status}
                  </span>
                ) : (
                  <span class="open-app">
                    View app
                    <span>↗</span>
                  </span>
                )
              }

            </div>

          </Card>
        );
      })
    }

  </div>

</section>


<style>

.apps {
  max-width: 1380px;
  margin: auto;

  padding: 100px 6vw;
}


/* HEADER */

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;

  margin-bottom: 45px;
}

.eyebrow {
  margin: 0 0 12px;

  font-size: 0.72rem;
  font-weight: 600;

  text-transform: uppercase;
  letter-spacing: 0.15em;

  color: var(--accent);
}

h2 {
  margin: 0;

  font-size: clamp(2.8rem, 5vw, 5rem);
  letter-spacing: -0.06em;
  line-height: 0.9;
}

.section-description {
  max-width: 300px;

  color: var(--ink-soft);

  font-size: 0.95rem;
  line-height: 1.5;
}


/* GRID */

.app-grid {
  display: grid;

  grid-template-columns: repeat(2, 1fr);

  gap: 18px;
}


/* CARD */

.app-card {
  min-height: 250px;

  padding: 32px;

  border-radius: 28px;

  background: #F0F0EB;

  color: var(--ink);

  text-decoration: none;

  display: flex;
  flex-direction: column;
  justify-content: space-between;

  overflow: hidden;

  transition:
    transform 250ms ease,
    background 250ms ease;
}

.app-card:hover {
  transform: translateY(-5px);
  background: #EAEAE3;
}


/* FIRST APP */

.app-card--1 {
  background: #E8EDE4;
}

.app-card--1:hover {
  background: #E1E8DC;
}


/* THIRD APP */

.app-card--3 {
  background: #F3F0F7;

  opacity: 0.75;
}


/* CONTENT */

.card-content {
  display: flex;
  flex-direction: column;

  gap: 26px;
}

.app-icon {
  width: 64px;
  height: 64px;

  border-radius: 17px;

  background: var(--ink);

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;
}

.app-icon img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.app-icon span {
  color: white;
  font-size: 1.4rem;
  font-weight: 600;
}


h3 {
  margin: 0 0 8px;

  font-size: 2.2rem;
  letter-spacing: -0.05em;
}

.card-content p {
  margin: 0;

  color: var(--ink-soft);

  font-size: 0.95rem;
}


/* FOOTER */

.card-footer {
  display: flex;
  align-items: center;
}

.open-app {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 16px;
  font-size: 0.85rem;
  font-weight: 600;
}

.open-app span {
  font-size: 1.1rem;
}

.status {
  font-size: 0.7rem;

  text-transform: uppercase;
  letter-spacing: 0.08em;

  color: var(--ink-soft);
}


/* SECOND CARD */

.app-card--2 {
  background: #E8EFEA;
}


/* MOBILE */

@media (max-width: 700px) {

  .apps {
    padding: 70px 24px;
  }

  .section-header {
    display: block;
  }

  .section-description {
    margin-top: 20px;
  }

  .app-grid {
    grid-template-columns: 1fr;
  }

  .app-card {
    min-height: 360px;
  }

  h3 {
    font-size: 1.9rem;
  }

}

</style>